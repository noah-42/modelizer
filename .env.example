# modelizer — secrets live here (or in your shell env), never in modelizer.toml or the DB.
# Copy to .env and fill in what you have; every provider is optional.

# OpenRouter (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=
# Optional, unlocks /credits + /activity (create a management key in dashboard settings)
OPENROUTER_MANAGEMENT_KEY=

# Z.AI (https://z.ai/manage-apikey/apikey) — create a DEDICATED key for modelizer so you can
# revoke it without touching your coding-agent keys. No read-only scope exists on Z.AI.
# Most secure on macOS: skip .env entirely and use the Keychain (README → Security):
#   security add-generic-password -s modelizer -a ZAI_API_KEY -w '<your key>'
ZAI_API_KEY=
# Optional team-scope headers (adds ?type=2/3 and Bigmodel-* headers)
ZAI_ORGANIZATION=
ZAI_PROJECT=

# Claude Pro/Max — no key needed: the adapter reads Claude Code's local session logs
# (~/.claude/projects). Set this only to point it elsewhere (e.g. a mock for UI dev).
# CLAUDE_PROJECTS_DIR=
# Optional "how much left" estimates: your effective budgets per 5h window. Anthropic
# doesn't publish limits — run /usage in Claude Code once, compare with the card, and
# calibrate. Reference point for Opus 5.5 on medium (2026-10-06): ~47M tokens ≈ 210 requests.
# CLAUDE_SESSION_TOKENS=
# CLAUDE_SESSION_TURNS=

# OpenAI via Codex (ChatGPT plan) — no key needed: the adapter reads Codex's local session
# logs (~/.codex/sessions). Override the directory with CODEX_SESSIONS_DIR.
# CODEX_SESSIONS_DIR=
# Optional "how much left" estimates: your effective budgets per 5h window. OpenAI doesn't
# publish ChatGPT-plan limits — run /status in Codex once, compare with the card, calibrate.
# CODEX_SESSION_TOKENS=
# CODEX_SESSION_TURNS=

# Moonshot / Kimi payg (https://platform.kimi.ai)
MOONSHOT_API_KEY=

# OpenAI payg — org admin key (https://developers.openai.com)
OPENAI_ADMIN_API_KEY=

# Anthropic payg — admin key (https://console.anthropic.com)
ANTHROPIC_ADMIN_API_KEY=

# Overrides for testing: point adapters at a local mock server
# OPENROUTER_BASE_URL=http://127.0.0.1:9801
# ZAI_BASE_URL=http://127.0.0.1:9802
